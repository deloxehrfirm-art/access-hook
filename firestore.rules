rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Admins are defined by a hardcoded email list or we can check an admins collection.
      // Let's use standard email check or verify if they are in the admins collection.
      return isSignedIn() && (
        request.auth.token.email == 'mosesoobaseki@gmail.com' ||
        request.auth.token.email == 'mosesobaseki@gmail.com' ||
        request.auth.token.email == 'admin@deloxehr.com'
      );
    }

    function isOwner(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Collection: Partners
    match /partners/{partnerId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow list: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }

    // Collection: Partner Stats
    match /partner_stats/{partnerId} {
      allow get: if isSignedIn() && (isAdmin() || partnerId == request.auth.uid || resource.data.partnerId == request.auth.uid || exists(/databases/$(database)/documents/partners/$(partnerId)) && get(/databases/$(database)/documents/partners/$(partnerId)).data.email == request.auth.token.email);
      allow list: if isSignedIn() && isAdmin();
      allow write: if isAdmin();
    }

    // Collection: Referral Clicks
    match /referral_clicks/{clickId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.partnerId == request.auth.uid || (exists(/databases/$(database)/documents/partners/$(resource.data.partnerId)) && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.email == request.auth.token.email));
      allow write: if isAdmin();
    }

    // Collection: Partner Commissions
    match /partner_commissions/{commissionId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.partnerId == request.auth.uid || (exists(/databases/$(database)/documents/partners/$(resource.data.partnerId)) && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.email == request.auth.token.email));
      allow write: if isAdmin();
    }

    // Collection: Partner Applications
    match /partner_applications/{applicationId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow list: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow create: if isSignedIn() && 
                    isValidId(applicationId) &&
                    request.resource.data.email == request.auth.token.email &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.keys().hasAll(['applicationId', 'name', 'email', 'audience', 'status', 'createdAt']) &&
                    request.resource.data.keys().size() == 6;
      allow update, delete: if isAdmin();
    }

    // Collection: Payout Logs
    match /payout_logs/{payoutId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.partnerId == request.auth.uid || (exists(/databases/$(database)/documents/partners/$(resource.data.partnerId)) && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.email == request.auth.token.email));
      allow write: if isAdmin();
    }

    // Collection: Notifications
    match /notifications/{notificationId} {
      allow get, list, update: if isSignedIn() && (isAdmin() || resource.data.partnerId == request.auth.uid || (exists(/databases/$(database)/documents/partners/$(resource.data.partnerId)) && get(/databases/$(database)/documents/partners/$(resource.data.partnerId)).data.email == request.auth.token.email));
      allow write: if isAdmin();
    }
  }
}
